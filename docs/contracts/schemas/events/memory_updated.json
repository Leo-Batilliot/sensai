    },
    "op": {
      "enum": [
        "create",
        "update",
        "delete"
      ]
    },
    "kind": {
      "enum": [
        "glossary",
        "entity",
        "relation",
        "fact"
      ]
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    }
