{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/context_injected.v1",
  "title": "Événement context_injected",
  "description": "Entrées de la mémoire fournies au modèle pour ce tour. Fait foi : docs/contracts/events.md §3.2. Propriétaire : P1.",
  "type": "object",
  "required": [
    "type",
    "session_id",
    "turn_id",
    "ts",
    "refs"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "context_injected"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "number",
      "description": "Secondes depuis l'epoch (flottant)"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "glossary",
              "entity",
              "relation",
              "fact"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
