{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/examples_injected.v1",
  "title": "Événement examples_injected",
  "description": "Exemples question → SQL ajoutés au prompt du tour (A7). Fait foi : docs/contracts/events.md §3.14. Propriétaire : P1.",
  "type": "object",
  "required": [
    "type",
    "session_id",
    "turn_id",
    "ts",
    "examples"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "examples_injected"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "number",
      "description": "Secondes depuis l'epoch (flottant)"
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "score"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          }
        }
      }
    }
  }
}
