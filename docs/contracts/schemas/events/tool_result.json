{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/tool_result.v1",
  "title": "Événement tool_result",
  "description": "Outil terminé, en échec ou refusé. Fait foi : docs/contracts/events.md §3.8. Propriétaire : P1.",
  "type": "object",
  "required": [
    "type",
    "session_id",
    "turn_id",
    "ts",
    "call_id",
    "ok",
    "summary",
    "data",
    "error",
    "duration_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "tool_result"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "number",
      "description": "Secondes depuis l'epoch (flottant)"
    },
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "error": {
        "type": "null"
      }
    }
  },
  "else": {
    "properties": {
      "error": {
        "type": "object"
      }
    }
  }
}
