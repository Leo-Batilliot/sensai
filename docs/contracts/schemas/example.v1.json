{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sensai.local/contracts/example.v1.json",
  "title": "Exemple question → SQL de la banque des exemples dynamiques (A7)",
  "description": "Une ligne de src/sensai/data/examples.jsonl. Contrat : docs/contracts/prompts.md §2. Propriétaire : P3.",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^ex-[0-9]{2,}$"},
    "question": {"type": "string", "minLength": 5, "maxLength": 300},
    "sql": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "pattern": "^\\s*(SELECT|WITH)\\b[^;]*$",
      "not": {"pattern": "date\\(\\s*'[nN][oO][wW]'"}
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"}
    }
  },
  "required": ["id", "question", "sql", "tags"],
  "additionalProperties": false
}
